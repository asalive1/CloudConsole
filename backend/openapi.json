{
  "openapi": "3.1.0",
  "info": {
    "title": "Cloud Console API",
    "version": "0.1.0",
    "description": "Station-scoped API for operator access, guest approval, Janus Program/Cue audio, mixer state, profanity delay, WHIP/WHEP streaming, configuration, and audio routing."
  },
  "servers": [{ "url": "/api" }],
  "components": {
    "securitySchemes": {
      "StationApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      },
      "GuestBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ApiError": {
        "type": "object",
        "required": ["error"],
        "properties": { "error": { "type": "string" } }
      },
      "Health": {
        "type": "object",
        "required": ["status"],
        "properties": { "status": { "type": "string", "enum": ["ok", "ready"] } }
      },
      "AuthValidation": {
        "type": "object",
        "required": ["authenticated", "station_id", "role"],
        "properties": {
          "authenticated": { "type": "boolean" },
          "station_id": { "type": "string", "format": "uuid" },
          "role": { "type": "string", "enum": ["station", "guest", "host", "co_host"] },
          "status": { "type": ["string", "null"] }
        }
      },
      "GuestLinkCreate": {
        "type": "object",
        "required": ["expires_at"],
        "properties": {
          "name": { "type": ["string", "null"] },
          "expires_at": { "type": "string", "format": "date-time" }
        }
      },
      "GuestLink": {
        "type": "object",
        "required": ["id", "expires_at", "invalidated_at", "invitation_token"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": ["string", "null"] },
          "expires_at": { "type": "string", "format": "date-time" },
          "invalidated_at": { "type": ["string", "null"], "format": "date-time" },
          "invitation_token": { "type": ["string", "null"], "description": "Returned only when the link is created." }
        }
      },
      "GuestSessionCreate": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 100 }
        }
      },
      "GuestSession": {
        "type": "object",
        "required": ["session_id", "display_name", "role", "status", "access_token", "expires_at"],
        "properties": {
          "session_id": { "type": "string", "format": "uuid" },
          "display_name": { "type": "string" },
          "role": { "type": "string", "const": "guest" },
          "status": { "type": "string", "enum": ["pending", "approved", "connected", "disconnected"] },
          "access_token": { "type": "string", "description": "Guest-scoped JWT." },
          "expires_at": { "type": "string", "format": "date-time" }
        }
      },
      "LiveSessionCreate": {
        "type": "object",
        "required": ["display_name", "role"],
        "properties": {
          "display_name": { "type": "string", "minLength": 1, "maxLength": 100 },
          "role": { "type": "string", "enum": ["host", "co_host"] }
        }
      },
      "LiveSession": {
        "type": "object",
        "required": ["id", "display_name", "role", "status", "expires_at"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "display_name": { "type": "string" },
          "role": { "type": "string", "enum": ["guest", "host", "co_host"] },
          "status": { "type": "string", "enum": ["pending", "approved", "connected", "disconnected", "rejected", "expired"] },
          "expires_at": { "type": "string", "format": "date-time" }
        }
      },
      "LiveSessionToken": {
        "type": "object",
        "required": ["session_id", "display_name", "role", "status", "access_token", "expires_at"],
        "properties": {
          "session_id": { "type": "string", "format": "uuid" },
          "display_name": { "type": "string" },
          "role": { "type": "string", "enum": ["host", "co_host"] },
          "status": { "type": "string", "const": "approved" },
          "access_token": { "type": "string", "description": "Participant-scoped JWT." },
          "expires_at": { "type": "string", "format": "date-time" }
        }
      },
      "GuestSessionStatus": {
        "type": "object",
        "required": ["session_id", "display_name", "role", "status", "expires_at"],
        "properties": {
          "session_id": { "type": "string", "format": "uuid" },
          "display_name": { "type": "string" },
          "role": { "type": "string", "const": "guest" },
          "status": { "type": "string", "enum": ["pending", "approved", "connected", "disconnected", "rejected", "expired"] },
          "expires_at": { "type": "string", "format": "date-time" }
        }
      },
      "JanusConnection": {
        "type": "object",
        "required": ["session_id", "display_name", "role", "websocket_url", "room_id", "room_pin", "ice_servers"],
        "properties": {
          "session_id": { "type": "string", "format": "uuid" },
          "display_name": { "type": "string" },
          "role": { "type": "string", "enum": ["guest", "host", "co_host"] },
          "websocket_url": { "type": "string" },
          "room_id": { "type": "integer" },
          "room_pin": { "type": "string", "description": "Only returned to approved live sessions." },
          "ice_servers": { "type": "array", "items": { "type": "object" } }
        }
      },
      "ConnectionState": {
        "type": "object",
        "required": ["state"],
        "properties": { "state": { "type": "string", "enum": ["connected", "disconnected"] } }
      },
      "StationConfig": {
        "type": "object",
        "required": ["id", "name", "inputs", "outputs", "metadata", "delay", "routing_rules"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "inputs": { "type": "array", "items": { "type": "object" } },
          "outputs": { "type": "array", "items": { "type": "object" } },
          "metadata": { "type": "array", "items": { "type": "object" } },
          "delay": { "type": "array", "items": { "type": "object" } },
          "routing_rules": { "type": "array", "items": { "type": "object" } }
        }
      },
      "User": {
        "type": "object",
        "required": ["id", "name", "role", "created_at"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "role": { "type": "string", "enum": ["host", "co_host", "guest", "admin"] },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "RtpEncoding": {
        "type": "string",
        "enum": ["l16", "l24"]
      },
      "SrtMode": {
        "type": "string",
        "enum": ["caller", "listener"]
      },
      "AudioHealth": {
        "type": "object",
        "required": ["status", "gstreamer_version"],
        "properties": {
          "status": { "type": "string", "const": "ok" },
          "gstreamer_version": { "type": "string" }
        }
      },
      "AudioSourceCreate": {
        "type": "object",
        "required": ["name", "source_type", "transport"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 100 },
          "source_type": { "type": "string", "enum": ["automation", "aux"] },
          "transport": { "$ref": "#/components/schemas/InputTransport" }
        }
      },
      "InputTransport": {
        "oneOf": [
          { "$ref": "#/components/schemas/TestInputTransport" },
          { "$ref": "#/components/schemas/RtpInputTransport" },
          { "$ref": "#/components/schemas/SrtInputTransport" },
          { "$ref": "#/components/schemas/AlsaInputTransport" }
        ],
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "test": "#/components/schemas/TestInputTransport",
            "rtp": "#/components/schemas/RtpInputTransport",
            "srt": "#/components/schemas/SrtInputTransport",
            "alsa": "#/components/schemas/AlsaInputTransport"
          }
        }
      },
      "TestInputTransport": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "type": "string", "const": "test" },
          "frequency": { "type": "integer", "minimum": 1, "maximum": 20000, "default": 440 }
        }
      },
      "RtpInputTransport": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "type": "string", "const": "rtp" },
          "address": { "type": "string", "default": "0.0.0.0" },
          "port": { "type": "integer", "minimum": 1, "maximum": 65535, "default": 5005 },
          "encoding": { "$ref": "#/components/schemas/RtpEncoding", "default": "l24" },
          "channels": { "type": "integer", "minimum": 1, "maximum": 2, "default": 2 },
          "payload_type": { "type": "integer", "minimum": 0, "maximum": 127, "default": 96 },
          "jitter_buffer_ms": { "type": "integer", "minimum": 0, "default": 100 },
          "multicast_interface": { "type": ["string", "null"] }
        }
      },
      "SrtInputTransport": {
        "type": "object",
        "required": ["type", "port"],
        "properties": {
          "type": { "type": "string", "const": "srt" },
          "host": { "type": "string", "default": "0.0.0.0" },
          "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "mode": { "$ref": "#/components/schemas/SrtMode", "default": "listener" },
          "latency_ms": { "type": "integer", "minimum": 20, "maximum": 90000, "default": 120 },
          "stream_id": { "type": ["string", "null"] },
          "passphrase": { "type": ["string", "null"], "writeOnly": true }
        }
      },
      "AlsaInputTransport": {
        "type": "object",
        "required": ["type", "device"],
        "properties": {
          "type": { "type": "string", "const": "alsa" },
          "device": { "type": "string", "minLength": 1, "maxLength": 128 },
          "sample_rate": { "type": "integer", "const": 48000, "default": 48000 },
          "channels": { "type": "integer", "minimum": 1, "maximum": 2, "default": 2 },
          "bit_depth": { "type": "integer", "enum": [16, 24], "default": 24 }
        }
      },
      "AudioOutputCreate": {
        "type": "object",
        "required": ["name", "transport"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 100 },
          "transport": { "$ref": "#/components/schemas/OutputTransport" }
        }
      },
      "OutputTransport": {
        "oneOf": [
          { "$ref": "#/components/schemas/AlsaOutputTransport" },
          { "$ref": "#/components/schemas/RtpOutputTransport" },
          { "$ref": "#/components/schemas/SrtOutputTransport" }
        ],
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "alsa": "#/components/schemas/AlsaOutputTransport",
            "rtp": "#/components/schemas/RtpOutputTransport",
            "srt": "#/components/schemas/SrtOutputTransport"
          }
        }
      },
      "AlsaOutputTransport": {
        "type": "object",
        "required": ["type", "device"],
        "properties": {
          "type": { "type": "string", "const": "alsa" },
          "device": { "type": "string", "minLength": 1, "maxLength": 128 },
          "sample_rate": { "type": "integer", "const": 48000, "default": 48000 },
          "channels": { "type": "integer", "minimum": 1, "maximum": 2, "default": 2 },
          "bit_depth": { "type": "integer", "enum": [16, 24], "default": 24 }
        }
      },
      "RtpOutputTransport": {
        "type": "object",
        "required": ["type", "host", "port"],
        "properties": {
          "type": { "type": "string", "const": "rtp" },
          "host": { "type": "string" },
          "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "encoding": { "$ref": "#/components/schemas/RtpEncoding", "default": "l24" },
          "channels": { "type": "integer", "minimum": 1, "maximum": 2, "default": 2 },
          "payload_type": { "type": "integer", "minimum": 0, "maximum": 127, "default": 96 }
        }
      },
      "SrtOutputTransport": {
        "type": "object",
        "required": ["type", "host", "port"],
        "properties": {
          "type": { "type": "string", "const": "srt" },
          "host": { "type": "string" },
          "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "mode": { "$ref": "#/components/schemas/SrtMode", "default": "caller" },
          "latency_ms": { "type": "integer", "minimum": 20, "maximum": 90000, "default": 120 },
          "stream_id": { "type": ["string", "null"] },
          "passphrase": { "type": ["string", "null"], "writeOnly": true },
          "pbkeylen": { "type": ["integer", "null"], "enum": [16, 24, 32, null] },
          "bitrate": { "type": "integer", "minimum": 1, "default": 128000 }
        }
      },
      "AudioSource": {
        "type": "object",
        "required": ["id", "name", "source_type", "transport", "state"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "source_type": { "type": "string", "enum": ["automation", "aux"] },
          "transport": { "type": "string", "enum": ["test", "rtp", "srt", "alsa"] },
          "state": { "type": "string", "enum": ["playing", "paused", "ready", "stopped", "transitioning"] }
        }
      },
      "AudioOutput": {
        "type": "object",
        "required": ["id", "name", "transport", "state"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "transport": { "type": "string", "enum": ["rtp", "srt", "alsa"] },
          "state": { "type": "string", "enum": ["playing", "paused", "ready", "stopped", "transitioning"] }
        }
      },
      "AudioSourceMetrics": {
        "type": "object",
        "required": ["id", "state", "peak_dbfs", "jitter_ms", "packets_lost", "configured_latency_ms"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "state": { "type": "string" },
          "peak_dbfs": { "type": ["array", "null"], "items": { "type": "number" } },
          "jitter_ms": { "type": ["number", "null"] },
          "packets_lost": { "type": ["integer", "null"], "minimum": 0 },
          "configured_latency_ms": { "type": ["integer", "null"], "minimum": 0 }
        }
      },
      "AudioMetrics": {
        "type": "object",
        "required": ["pipeline_state", "source_count", "output_count", "program_peak_dbfs", "pipeline_latency_ms", "sources", "last_pipeline_error"],
        "properties": {
          "pipeline_state": { "type": "string", "enum": ["playing", "paused", "ready", "stopped", "transitioning"] },
          "source_count": { "type": "integer", "minimum": 0 },
          "output_count": { "type": "integer", "minimum": 0 },
          "program_peak_dbfs": { "type": ["array", "null"], "items": { "type": "number" } },
          "pipeline_latency_ms": { "type": ["number", "null"] },
          "sources": { "type": "array", "items": { "$ref": "#/components/schemas/AudioSourceMetrics" } },
          "last_pipeline_error": { "type": ["string", "null"] }
        }
      },
      "DelayStatus": {
        "type": "object",
        "required": ["configured_delay_seconds", "buffered_delay_seconds", "recovery_percent", "state"],
        "properties": {
          "configured_delay_seconds": { "type": "integer", "minimum": 5, "maximum": 60 },
          "buffered_delay_seconds": { "type": "number", "minimum": 0 },
          "recovery_percent": { "type": "number", "minimum": 0, "maximum": 100 },
          "state": { "type": "string", "enum": ["normal", "dumped", "rebuilding", "ending_delay", "live"] }
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Liveness check",
        "responses": {
          "200": { "description": "Service is running", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Health" } } } }
        }
      }
    },
    "/ready": {
      "get": {
        "summary": "Readiness check",
        "responses": {
          "200": { "description": "Database is available", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Health" } } } },
          "500": { "description": "Database is unavailable", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Validate station API key",
        "security": [{ "StationApiKey": [] }],
        "responses": {
          "200": { "description": "Key is valid", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthValidation" } } } },
          "401": { "description": "Key is invalid", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } }
        }
      }
    },
    "/auth/validate": {
      "get": {
        "summary": "Validate station API key or guest session JWT",
        "security": [{ "StationApiKey": [] }, { "GuestBearer": [] }],
        "responses": {
          "200": { "description": "Credential is valid", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthValidation" } } } },
          "401": { "description": "Credential is invalid or expired", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } }
        }
      }
    },
    "/station/config": {
      "get": {
        "summary": "Read station configuration",
        "security": [{ "StationApiKey": [] }],
        "responses": {
          "200": { "description": "Station configuration", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/StationConfig" } } } },
          "401": { "description": "Key is invalid", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } }
        }
      }
    },
    "/station/health": {
      "get": {
        "summary": "Read station health",
        "security": [{ "StationApiKey": [] }],
        "responses": {
          "200": { "description": "Station health", "content": { "application/json": { "schema": { "type": "object" } } } }
        }
      }
    },
    "/guest-links": {
      "get": {
        "summary": "List guest links",
        "security": [{ "StationApiKey": [] }],
        "responses": {
          "200": { "description": "Guest links", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/GuestLink" } } } } }
        }
      },
      "post": {
        "summary": "Create guest link",
        "security": [{ "StationApiKey": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GuestLinkCreate" } } }
        },
        "responses": {
          "201": { "description": "Guest link and one-time invitation token", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GuestLink" } } } },
          "400": { "description": "Invalid expiration time", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } }
        }
      }
    },
    "/guest-links/{id}": {
      "delete": {
        "summary": "Invalidate guest link",
        "security": [{ "StationApiKey": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": {
          "204": { "description": "Link invalidated" },
          "404": { "description": "Link not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } }
        }
      }
    },
    "/guest-links/{token}/sessions": {
      "post": {
        "summary": "Create pending guest session and scoped JWT",
        "parameters": [{ "name": "token", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GuestSessionCreate" } } }
        },
        "responses": {
          "200": { "description": "Existing guest session resumed", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GuestSession" } } } },
          "201": { "description": "Pending guest session", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GuestSession" } } } },
          "401": { "description": "Link is invalid or expired", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } },
          "409": { "description": "Invitation link already has an active session", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } }
        }
      }
    },
    "/live-sessions": {
      "get": {
        "summary": "List recent live and guest sessions",
        "security": [{ "StationApiKey": [] }],
        "responses": {
          "200": { "description": "Recent station sessions", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/LiveSession" } } } } }
        }
      },
      "post": {
        "summary": "Create a host or co-host live session",
        "security": [{ "StationApiKey": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LiveSessionCreate" } } }
        },
        "responses": {
          "201": { "description": "Approved participant session and JWT", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LiveSessionToken" } } } },
          "400": { "description": "Invalid session details", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } }
        }
      }
    },
    "/live-sessions/{id}/approve": {
      "post": {
        "summary": "Approve a pending guest",
        "security": [{ "StationApiKey": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": {
          "200": { "description": "Guest approved", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LiveSession" } } } },
          "404": { "description": "No pending guest session found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } }
        }
      }
    },
    "/live-sessions/{id}/reject": {
      "post": {
        "summary": "Reject a pending guest",
        "security": [{ "StationApiKey": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": {
          "200": { "description": "Guest rejected", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LiveSession" } } } },
          "404": { "description": "No pending guest session found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } }
        }
      }
    },
    "/guest-session/{id}": {
      "get": {
        "summary": "Read the guest's approval status",
        "security": [{ "GuestBearer": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": {
          "200": { "description": "Guest session status", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GuestSessionStatus" } } } },
          "401": { "description": "Guest credential is invalid or revoked", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } }
        }
      }
    },
    "/live-sessions/{id}/connection": {
      "get": {
        "summary": "Get Janus room credentials for an approved participant",
        "security": [{ "GuestBearer": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": {
          "200": { "description": "Janus WebSocket and ICE configuration", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/JanusConnection" } } } },
